{
  "name": "airbnb-market-observer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/refresh/*.test.mjs && vitest run && npm run typecheck",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/validate-data.mjs && node scripts/validate-observatory.mjs && node scripts/validate-refresh.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:e2e": "playwright test",
    "data:refresh": "node scripts/refresh-official.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
